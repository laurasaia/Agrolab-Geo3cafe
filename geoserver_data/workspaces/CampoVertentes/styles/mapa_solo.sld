          <ogc:Filter>
            <ogc:PropertyIsEqualTo>
              <ogc:PropertyName>legenda</ogc:PropertyName>
              <ogc:Literal>Neossolo litólico distrófico</ogc:Literal>
            </ogc:PropertyIsEqualTo>
          </ogc:Filter>
          <PolygonSymbolizer>
            <Fill>
              <CssParameter name="fill">#96b395</CssParameter>
            </Fill>
            <Stroke>
              <CssParameter name="stroke">#232323</CssParameter>
              <CssParameter name="stroke-width">1</CssParameter>
              <CssParameter name="stroke-linejoin">bevel</CssParameter>
            </Stroke>
          </PolygonSymbolizer>
        </Rule>
        <Rule>
          <Name>Nitossolo haplico distrofico</Name>
          <Title>Nitossolo háplico distrófico</Title>
          <ogc:Filter>
            <ogc:PropertyIsEqualTo>
              <ogc:PropertyName>legenda</ogc:PropertyName>
